# Base URL for the real backend API (unused while VITE_USE_MOCKS=true)
VITE_API_BASE_URL=http://localhost:8000/api

# "true" (default when unset) serves every service call from local mock data.
# Set to "false" once the backend in ../backend is ready to switch over.
VITE_USE_MOCKS=true

# PostHog project API key + region host (client-side key, safe to expose in the build)
VITE_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxx
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
